# Auto detect text files and perform LF normalization
* text=auto

# Flutter/Dart files
*.dart text
*.yaml text
*.json text
*.md text

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archives
*.zip binary
*.tar.gz binary

# Executables
*.so binary
*.jar binary
*.dylib binary
*.dll binary
*.exe binary
